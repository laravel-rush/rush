{
    "name": "laravel-rush/rush",
    "description": "An artisan command for fast building Database Schema",
    "keywords": ["php", "package", "artisan", "tool", "database", "models", "migrations"],
    "license": "MIT",
    "authors": [
        {
            "name": "Kiryl Zuyeu",
            "email": "kirillzuyeu@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4.0",
        "illuminate/console": "^12.41",
        "illuminate/support": "^12.41",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "laravel/pint": "^1.24.0",
        "orchestra/testbench-dusk": "10.x-dev",
        "peckphp/peck": "^0.1.3",
        "pestphp/pest": "^4.1.0",
        "phpstan/phpstan": "^2.1.26",
        "rector/rector": "^2.1.7",
        "symfony/var-dumper": "^7.3.3"
    },
    "autoload": {
        "psr-4": {
            "LaravelRush\\Rush\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelRush\\Rush\\RushServiceProvider"
            ]
        }
    },
    "scripts": {
        "lint": "pint",
        "refactor": "rector",
        "fix": [
            "@refactor",
            "@lint"
        ],
        "test:lint": "pint --test",
        "test:unit": "pest --coverage --exactly=100",
        "test:types": "phpstan",
        "test:refactor": "rector --dry-run",
        "test": [
            "@test:lint",
            "@test:unit",
            "@test:types",
            "@test:refactor"
        ]
    }
}
